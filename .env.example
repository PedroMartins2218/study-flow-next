# Copie este arquivo para .env.local e preencha com valores reais.
# .env.local NUNCA deve ser commitado (já está no .gitignore padrão do Next.js).

# --- Firebase client (públicas, seguras para expor no navegador) ---
# Pegue em: Firebase Console > Configurações do projeto > Seus apps > Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (SECRETAS — usadas só no servidor, fase 2/3) ---
# Gere em: Firebase Console > Configurações do projeto > Contas de serviço > Gerar nova chave privada
# Copie os valores do JSON gerado (não cole o arquivo JSON inteiro no repositório).
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Cakto (pagamento/assinatura) ---
# Links de checkout de cada plano, usados na landing e na tela /assinatura
# (públicas, podem expor). Pegue em: Cakto > Produtos > Ofertas.
NEXT_PUBLIC_CAKTO_CHECKOUT_BASE_URL=
NEXT_PUBLIC_CAKTO_CHECKOUT_PRO_URL=

# Id da oferta de cada plano, exatamente como vem em data.offer.id no payload
# do webhook. É o que diz ao backend se a compra foi Base ou Pro.
# Sem isso, toda compra é tratada como Base (nunca liberamos Pro no escuro).
CAKTO_OFERTA_BASE_ID=
CAKTO_OFERTA_PRO_ID=

# Oferta VITALÍCIA (opcional): compra única que dá acesso Pro para sempre.
# Não aparece na landing — é um link avulso, entregue só a quem você escolher.
# Deixe vazio se ainda não criou essa oferta na Cakto.
CAKTO_OFERTA_VITALICIO_ID=

# Segredo do webhook da Cakto (SECRETO). A Cakto NÃO assina o payload com HMAC
# nem manda header de assinatura: ela envia este valor no campo "secret" dentro
# do corpo, e ele é a única prova de origem. Sem esta variável configurada o
# endpoint RECUSA todos os eventos (falha fechado, de propósito).
CAKTO_WEBHOOK_SECRET=

# --- Agente de IA (plano Pro) ---
# Chave da API do Gemini (SECRETA — nunca prefixar com NEXT_PUBLIC_).
GEMINI_API_KEY=
# Modelo usado na extração. Confirme o id disponível na sua conta.
GEMINI_MODEL=gemini-flash-lite-latest
# Teto de análises de IA por usuário Pro por mês (controle de custo).
IA_LIMITE_PRO=100

# --- Admin (SECRETO) ---
# Chave para acessar o painel de reservas em /admin. Escolha um valor forte.
ADMIN_SECRET=
